# language: dotenv, file: .env.example
# Ин файли намуна аст. Нусха гиред ба .env ва арзишҳои ҳақиқиро гузоред.
# Файли .env ҲЕҶ ГОҲ ба GitHub намеравад.

# --- Telegram Bot (@BotFather) ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Telegram API (my.telegram.org → API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Админҳои аввал (ID-ҳо бо вергул, бе фосила) ---
# ID-и худатро чӣ тавр донем: @userinfobot дар Telegram
SUPER_ADMINS=123456789

# --- Танзимоти фосила (сония) ---
DEFAULT_DELAY=300
MIN_DELAY=120
MAX_DELAY=1200

# --- Нархи нест кардани имзо (ситора) ---
DEFAULT_UNSIGN_PRICE=100

# --- Роҳҳо ---
DB_PATH=bot.db
SESSIONS_DIR=sessions
DATABASE_URL=
